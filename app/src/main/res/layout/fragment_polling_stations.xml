<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ajouter un Bureau de Vote"
            android:textSize="24sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ID du bureau"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/station_id_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Entrez l'ID du bureau"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Capacité"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/capacity_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Entrez la capacité"
            android:inputType="number"/>

        <Button
            android:id="@+id/create_station_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Créer le bureau"
            android:layout_marginTop="24dp"/>
    </LinearLayout>
</ScrollView>