<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Créer une Circonscription"
            android:textSize="24sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Code"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/district_code_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Entrez le code"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nom"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/district_name_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Entrez le nom"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre de bureaux"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/district_offices_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Entrez le nombre"
            android:inputType="number"/>

        <Button
            android:id="@+id/create_district_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Créer la circonscription"
            android:layout_marginTop="24dp"/>
    </LinearLayout>
</ScrollView>