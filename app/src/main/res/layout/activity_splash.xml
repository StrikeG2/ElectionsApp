<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/background_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background">

    <!-- Point décoratif bleu foncé (en haut à gauche) -->
    <ImageView
        android:id="@+id/dot1"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="50dp"
        android:layout_marginTop="260dp"
        android:background="@drawable/circle_dark_blue"
        android:alpha="1" />

    <!-- Point décoratif vert (à droite) -->
    <ImageView
        android:id="@+id/dot2"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="70dp"
        android:layout_marginTop="320dp"
        android:background="@drawable/circle_green"
        android:alpha="1" />

    <!-- Cercle de fond transparent pour le logo -->
    <View
        android:id="@+id/logo_circle"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_centerInParent="true"
        android:background="@drawable/circle_transparent_white"
        android:alpha="1" />

    <!-- Logo Result241 centré avec couleurs -->
    <TextView
        android:id="@+id/logo_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="Result241"
        android:textSize="32sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:alpha="1" />

    <!-- Point décoratif orange (en bas) -->
    <ImageView
        android:id="@+id/dot3"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="580dp"
        android:background="@drawable/circle_orange"
        android:alpha="1" />

</RelativeLayout>